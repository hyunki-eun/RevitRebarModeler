<Window x:Class="RevitRebarModeler.UI.TransverseRebarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="횡방향 철근 배치" Width="820" Height="750" MinHeight="750" MaxHeight="750" MaxWidth="820" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5" FontFamily="맑은 고딕">

    <Window.Resources>
        <Style TargetType="Button" x:Key="ActionBtn">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="PrimaryBtn">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" Opacity="0.25" ShadowDepth="1" Color="#064E3B"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#047857"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Background" Value="#94A3B8"/>
                                <Setter TargetName="Root" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecBtn">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="횡방향 철근 배치" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
            <TextBlock Text="JSON의 TransverseRebars를 구조도별 Host에 자동 매칭하여 배치합니다." FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>

            <!-- 일람표 마크 규칙 다이어그램 -->
            <Border Background="#F8FAFC" CornerRadius="6" Padding="12" Margin="0,8,0,0"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="일람표 마크 규칙 (A 시리즈)" FontSize="11" FontWeight="SemiBold"
                               Foreground="#475569" Margin="0,0,0,4"/>
                    <TextBlock Text="구조도별로 inner → outer 순서, k 인덱스 오름차순으로 A1, A2, A3 … 부여. Cycle 2는 -1 suffix 추가."
                               FontSize="10" Foreground="#94A3B8" Margin="0,0,0,8"/>

                    <Grid Height="90">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>   <!-- 왼쪽 레이블 -->
                            <ColumnDefinition Width="*"/>    <!-- 다이어그램 영역 -->
                        </Grid.ColumnDefinitions>

                        <!-- 좌측 행 레이블 -->
                        <Grid Grid.Column="0">
                            <TextBlock Text="외측 (Outer)" FontSize="10" FontWeight="SemiBold" Foreground="#1E293B"
                                       VerticalAlignment="Top" Margin="0,16,0,0"/>
                            <TextBlock Text="내측 (Inner)" FontSize="10" FontWeight="SemiBold" Foreground="#1E293B"
                                       VerticalAlignment="Bottom" Margin="0,0,0,12"/>
                        </Grid>

                        <!-- 점 + 라벨 그리드 -->
                        <Grid Grid.Column="1">
                            <!-- 외측 라인 + 점 (k=1,2,3) → A4, A5, A6 -->
                            <Line X1="20" Y1="22" X2="430" Y2="22" Stroke="#94A3B8" StrokeThickness="2"/>

                            <Ellipse Width="11" Height="11" Fill="#EF4444"
                                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="60,17,0,0"/>
                            <TextBlock Text="A4" FontSize="11" FontWeight="Bold" Foreground="#B91C1C"
                                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="58,1,0,0"/>

                            <Ellipse Width="11" Height="11" Fill="#EF4444"
                                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="200,17,0,0"/>
                            <TextBlock Text="A5" FontSize="11" FontWeight="Bold" Foreground="#B91C1C"
                                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="198,1,0,0"/>

                            <Ellipse Width="11" Height="11" Fill="#EF4444"
                                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="340,17,0,0"/>
                            <TextBlock Text="A6" FontSize="11" FontWeight="Bold" Foreground="#B91C1C"
                                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="338,1,0,0"/>

                            <!-- 내측 라인 + 점 (k=1,2,3) → A1, A2, A3 -->
                            <Line X1="20" Y1="68" X2="430" Y2="68" Stroke="#94A3B8" StrokeThickness="2"/>

                            <Ellipse Width="11" Height="11" Fill="#3B82F6"
                                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="60,63,0,0"/>
                            <TextBlock Text="A1" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8"
                                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="58,76,0,0"/>

                            <Ellipse Width="11" Height="11" Fill="#3B82F6"
                                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="200,63,0,0"/>
                            <TextBlock Text="A2" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8"
                                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="198,76,0,0"/>

                            <Ellipse Width="11" Height="11" Fill="#3B82F6"
                                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="340,63,0,0"/>
                            <TextBlock Text="A3" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8"
                                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="338,76,0,0"/>

                            <!-- k 인덱스 표시 (왼쪽부터 1→ 3) -->
                            <TextBlock Text="k=1" FontSize="9" Foreground="#94A3B8" FontStyle="Italic"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="48,0,0,0"/>
                            <TextBlock Text="k=2" FontSize="9" Foreground="#94A3B8" FontStyle="Italic"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="188,0,0,0"/>
                            <TextBlock Text="k=3" FontSize="9" Foreground="#94A3B8" FontStyle="Italic"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="328,0,0,0"/>
                        </Grid>
                    </Grid>

                    <TextBlock FontSize="10" Foreground="#64748B" Margin="0,4,0,0">
                        <Run Text="● " Foreground="#3B82F6"/><Run Text="내측 먼저 " FontWeight="SemiBold"/>
                        <Run Text="(A1→A2→A3)  →  "/>
                        <Run Text="● " Foreground="#EF4444"/><Run Text="외측 " FontWeight="SemiBold"/>
                        <Run Text="(A4→A5→A6)  |  2Cycle: A1-1, A2-1, A3-1, A4-1, A5-1, A6-1"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 세션 JSON 경로 표시 (작게) -->
        <TextBlock Grid.Row="1" x:Name="TxtJsonPath" Margin="0,0,0,8"
                   FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>

        <!-- 구조도별 CTC 및 철근 선택 (통합) -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" Padding="14" Margin="0,0,0,8"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="구조도별 CTC 및 배치 철근 선택" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8"/>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="전체 선택" Style="{StaticResource SecBtn}" Click="BtnSelectAll_Click" Margin="0,0,4,0"/>
                    <Button Content="전체 해제" Style="{StaticResource SecBtn}" Click="BtnDeselectAll_Click" Margin="0,0,12,0"/>
                    <TextBlock x:Name="TxtSelectionInfo" VerticalAlignment="Center" Foreground="#64748B" FontSize="12"/>
                </StackPanel>
                <ListView x:Name="LstRebars" BorderBrush="#E2E8F0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <Expander IsExpanded="True" Margin="0,0,0,6"
                                                          Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1">
                                                    <Expander.Header>
                                                        <Grid HorizontalAlignment="Stretch" Margin="4,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                                       FontWeight="Bold" FontSize="13" Foreground="#1E293B"
                                                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                                       Foreground="#475569" FontSize="11">
                                                                <Run Text="1Cycle "/>
                                                                <Run Text="{Binding Items[0].Cycle1Count, Mode=OneWay, FallbackValue=0}" FontWeight="SemiBold"/>
                                                                <Run Text="  · 2Cycle "/>
                                                                <Run Text="{Binding Items[0].Cycle2Count, Mode=OneWay, FallbackValue=0}" FontWeight="SemiBold"/>
                                                                <Run Text="  · 합계 "/>
                                                                <Run Text="{Binding ItemCount, Mode=OneWay}" FontWeight="SemiBold"/>
                                                                <Run Text="개"/>
                                                                <Run Text="  · 마크 " Foreground="#64748B"/>
                                                                <Run Text="{Binding Items[0].SheetMarkRangeDisplay, Mode=OneWay, FallbackValue=—}"
                                                                     FontWeight="SemiBold" Foreground="#7C3AED"/>
                                                            </TextBlock>
                                                            <!-- 구조물 두께 (구조물 생성에서 설정한 depth, 읽기 전용) -->
                                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11"
                                                                       Margin="8,0,12,0"
                                                                       ToolTip="구조물 생성 시 호스트에 저장된 돌출 깊이 (편집은 구조물 생성에서)">
                                                                <Run Text="두께 " Foreground="#475569"/>
                                                                <Run Text="{Binding Items[0].SheetDepthDisplay, Mode=OneWay, FallbackValue=—}"
                                                                     FontWeight="SemiBold" Foreground="#0F766E"/>
                                                            </TextBlock>
                                                            <TextBlock Grid.Column="3" Text="CTC (mm):" VerticalAlignment="Center"
                                                                       Foreground="#475569" FontSize="11" Margin="0,0,4,0"/>
                                                            <TextBox Grid.Column="4"
                                                                     Text="{Binding Items[0].SheetCtcMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=200}"
                                                                     Width="60" Height="22" VerticalContentAlignment="Center"
                                                                     HorizontalContentAlignment="Center" Margin="0,0,12,0"/>
                                                            <TextBlock Grid.Column="5" VerticalAlignment="Center"
                                                                       Foreground="#2563EB" FontSize="11" FontWeight="SemiBold">
                                                                <Run Text="선택 "/>
                                                                <Run Text="{Binding Items[0].SheetSelectedCount, Mode=OneWay, FallbackValue=0}"/>
                                                                <Run Text="/"/>
                                                                <Run Text="{Binding ItemCount, Mode=OneWay}"/>
                                                            </TextBlock>
                                                            <StackPanel Grid.Column="6" Orientation="Horizontal" Margin="12,0,0,0">
                                                                <Button Content="✓ 전체" Style="{StaticResource SecBtn}"
                                                                        Tag="{Binding Name}" Click="BtnSheetSelectAll_Click"
                                                                        Padding="6,2" FontSize="10" Margin="0,0,4,0"/>
                                                                <Button Content="✗ 해제" Style="{StaticResource SecBtn}"
                                                                        Tag="{Binding Name}" Click="BtnSheetDeselectAll_Click"
                                                                        Padding="6,2" FontSize="10"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Expander.Header>
                                                    <ItemsPresenter/>
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="40">
                                <GridViewColumn.Header>
                                    <CheckBox x:Name="ChkAll" IsChecked="True" Click="ChkAll_Click"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Click="RebarCheckBox_Click" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="ID" Width="60" DisplayMemberBinding="{Binding Id}"/>
                            <GridViewColumn Header="사이클" Width="70" DisplayMemberBinding="{Binding CycleNumber}"/>
                            <GridViewColumn Header="규격" Width="80" DisplayMemberBinding="{Binding MatchedText}"/>
                            <GridViewColumn Header="직경" Width="70" DisplayMemberBinding="{Binding DiameterMm}"/>
                            <GridViewColumn Header="세그먼트" Width="80" DisplayMemberBinding="{Binding SegmentCount}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>

        <!-- 상태 -->
        <Border Grid.Row="3" Background="White" CornerRadius="6" Padding="14" Margin="0,0,0,8"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <TextBlock x:Name="TxtInfo" Foreground="#64748B" FontSize="11" TextWrapping="Wrap"/>
        </Border>

        <!-- 하단 버튼 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="배치 실행" Style="{StaticResource PrimaryBtn}" Width="140" Height="44" Click="BtnPlace_Click" x:Name="BtnPlace" IsEnabled="False" Margin="0,0,8,0"/>
            <Button Content="취소" Style="{StaticResource SecBtn}" Width="80" Height="38" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
