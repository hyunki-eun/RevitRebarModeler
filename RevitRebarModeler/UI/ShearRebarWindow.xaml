<Window x:Class="RevitRebarModeler.UI.ShearRebarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="전단철근 배치" Width="980" Height="720" MinWidth="840" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5" FontFamily="맑은 고딕">

    <Window.Resources>
        <Style TargetType="Button" x:Key="PrimaryBtn">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" Opacity="0.25" ShadowDepth="1" Color="#064E3B"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#047857"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Background" Value="#94A3B8"/>
                                <Setter TargetName="Root" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecBtn">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="전단철근 배치" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                <TextBlock Text="횡철근 묶음 + 종철근 단(段) 매핑으로 U자형 전단철근을 자동 배치합니다."
                           FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>

                <!-- 일람표 마크 규칙 다이어그램 (가로 위치 = T 번호) -->
                <Border Background="#F8FAFC" CornerRadius="6" Padding="12" Margin="0,8,0,0"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="일람표 마크 규칙 (T 시리즈)" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBlock Text="T 번호 = 전단철근의 가로 위치. 내측·외측을 잇는 같은 위치의 전단철근은 깊이·묶음과 무관하게 같은 T. → 항상 좌=T1, 중=T2, 우=T3."
                                   FontSize="10" Foreground="#94A3B8" Margin="0,0,0,8" TextWrapping="Wrap"/>

                        <Grid Height="96">
                            <!-- 외측 / 내측 기준선 -->
                            <Line X1="40" Y1="20" X2="520" Y2="20" Stroke="#CBD5E1" StrokeThickness="2"/>
                            <Line X1="40" Y1="74" X2="520" Y2="74" Stroke="#CBD5E1" StrokeThickness="2"/>
                            <TextBlock Text="외측 (4·5·6)" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="528,14,0,0"/>
                            <TextBlock Text="내측 (1·2·3)" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="528,68,0,0"/>

                            <!-- 좌(T1): 내측1 ↔ 외측4 -->
                            <Line X1="110" Y1="20" X2="110" Y2="74" Stroke="#7C3AED" StrokeThickness="3"/>
                            <Ellipse Width="10" Height="10" Fill="#7C3AED" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="105,15,0,0"/>
                            <Ellipse Width="10" Height="10" Fill="#7C3AED" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="105,69,0,0"/>
                            <Border Background="#EDE9FE" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="90,40,0,0">
                                <TextBlock Text="T1 좌" FontSize="11" FontWeight="Bold" Foreground="#6D28D9"/>
                            </Border>

                            <!-- 중(T2): 내측2 ↔ 외측5 -->
                            <Line X1="280" Y1="20" X2="280" Y2="74" Stroke="#7C3AED" StrokeThickness="3"/>
                            <Ellipse Width="10" Height="10" Fill="#7C3AED" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="275,15,0,0"/>
                            <Ellipse Width="10" Height="10" Fill="#7C3AED" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="275,69,0,0"/>
                            <Border Background="#EDE9FE" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="260,40,0,0">
                                <TextBlock Text="T2 중" FontSize="11" FontWeight="Bold" Foreground="#6D28D9"/>
                            </Border>

                            <!-- 우(T3): 내측3 ↔ 외측6 -->
                            <Line X1="450" Y1="20" X2="450" Y2="74" Stroke="#7C3AED" StrokeThickness="3"/>
                            <Ellipse Width="10" Height="10" Fill="#7C3AED" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="445,15,0,0"/>
                            <Ellipse Width="10" Height="10" Fill="#7C3AED" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="445,69,0,0"/>
                            <Border Background="#EDE9FE" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="430,40,0,0">
                                <TextBlock Text="T3 우" FontSize="11" FontWeight="Bold" Foreground="#6D28D9"/>
                            </Border>
                        </Grid>

                        <TextBlock FontSize="10" Foreground="#64748B" Margin="0,6,0,0">
                            <Run Text="예) 횡철근 6개(내측 1·2·3 / 외측 4·5·6) → 전단철근 마크는 " />
                            <Run Text="좌=T1, 중=T2, 우=T3" FontWeight="SemiBold" Foreground="#6D28D9"/>
                            <Run Text=" 3종류만 (깊이 방향 개수와 무관)."/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
            <Button Grid.Column="1" x:Name="BtnHelpGroup" Content="?  A/B 묶음 설명"
                    Click="BtnHelpGroup_Click"
                    VerticalAlignment="Top" Margin="12,2,0,0"
                    Background="#F1F5F9" Foreground="#0F172A"
                    BorderBrush="#CBD5E1" BorderThickness="1"
                    Padding="10,4" FontSize="11" Cursor="Hand"
                    ToolTip="시작 묶음 A와 B의 배치 차이를 다이어그램으로 비교합니다"/>
        </Grid>

        <!-- 세션 JSON 경로 + 상태 (작게) -->
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock x:Name="TxtJsonPath" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="TxtSessionInfo" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 구조도별 전단철근 설정 -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" Padding="14" Margin="0,0,0,8"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="구조도별 전단철근 설정" FontSize="14" FontWeight="SemiBold"
                           Foreground="#1E293B" Margin="0,0,0,8"/>
                <TextBlock DockPanel.Dock="Top"
                           Text="묶음 수: 횡철근을 N개씩 묶음 (나머지가 N보다 작으면 미배치). 시작 묶음(A/B)부터 홀수 단마다 교대 배치."
                           FontSize="10" Foreground="#94A3B8" Margin="0,0,0,8" TextWrapping="Wrap"/>

                <ListView x:Name="LstSheets" BorderBrush="#E2E8F0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="구조도" Width="80" DisplayMemberBinding="{Binding SheetKey}"/>
                            <GridViewColumn Header="마크" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding MarkRangeDisplay}"
                                                   Foreground="#7C3AED" FontWeight="SemiBold"
                                                   ToolTip="일람표2/3에서 부여될 예상 마크 라벨 범위"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="횡방향(단)" Width="80" DisplayMemberBinding="{Binding TransUnitCount}"/>
                            <GridViewColumn Header="종방향(단)" Width="80" DisplayMemberBinding="{Binding LongiUnitCount}"/>
                            <GridViewColumn Header="묶음 수" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding GroupSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="60" HorizontalAlignment="Center" VerticalContentAlignment="Center" Height="22"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="묶음 분할" Width="180">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding GroupPreview}" FontSize="11" Foreground="#475569" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="시작 묶음" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding StartGroup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemsSource="{Binding DataContext.GroupOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Width="65" Height="24"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="직경" Width="75">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding DiameterLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemsSource="{Binding DataContext.DiameterOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Width="60" Height="24"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="등급" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding Grade, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemsSource="{Binding DataContext.GradeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Width="65" Height="24"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="후크 길이(mm)" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding HookLengthMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="80" HorizontalAlignment="Center" VerticalContentAlignment="Center" Height="22"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="상태" Width="160">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusBrush}" CornerRadius="3" Padding="8,3"
                                                HorizontalAlignment="Left" Opacity="0.92">
                                            <TextBlock Text="{Binding StatusText}" Foreground="White"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding StatusText}"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>

        <!-- 상태 -->
        <Border Grid.Row="3" Background="White" CornerRadius="6" Padding="14" Margin="0,0,0,8"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <TextBlock x:Name="TxtInfo" Foreground="#64748B" FontSize="11" TextWrapping="Wrap"/>
        </Border>

        <!-- 하단 버튼 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="배치 실행" Style="{StaticResource PrimaryBtn}" Width="140" Height="44" Click="BtnPlace_Click" x:Name="BtnPlace" IsEnabled="False" Margin="0,0,8,0"/>
            <Button Content="취소" Style="{StaticResource SecBtn}" Width="80" Height="38" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
